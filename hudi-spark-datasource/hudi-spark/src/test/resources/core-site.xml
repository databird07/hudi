<configuration>
  <!-- Without the Hadoop native library (the usual case for local and CI test runs) the stock local
       file system forks a chmod process for every file and directory it creates. This one sets the
       rwx bits via java.nio instead; see NioPermissionLocalFileSystem. -->
  <property>
    <name>fs.file.impl</name>
    <value>org.apache.hudi.testutils.NioPermissionLocalFileSystem</value>
  </property>
</configuration>
